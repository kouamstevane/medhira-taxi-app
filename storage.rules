rules_version = '2';

// Règles de sécurité pour Firebase Storage
service firebase.storage {
  match /b/{bucket}/o {
    function isDeliveryProofParticipant(orderId) {
      return firestore.exists(/databases/(default)/documents/food_delivery_orders/$(orderId))
        && (firestore.get(/databases/(default)/documents/food_delivery_orders/$(orderId)).data.driverId == request.auth.uid
            || firestore.get(/databases/(default)/documents/food_delivery_orders/$(orderId)).data.clientId == request.auth.uid);
    }
    
    // ========== AJOUTEZ CECI ==========
    // Logo public pour les emails et l'application
    match /logo/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 2 * 1024 * 1024;
    }
    // ==================================

    // Images de profil des utilisateurs
    match /profile_images/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
    
    // Documents des chauffeurs (permis, carte grise, etc.)
    // SÉCURITÉ: Restreint l'accès en lecture au propriétaire uniquement
    match /drivers/{driverId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == driverId;
      allow write: if request.auth != null
                && request.auth.uid == driverId
                && request.resource.size < 10 * 1024 * 1024
                && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == driverId;
    }
    
    // Documents généraux liés aux chauffeurs
    // SÉCURITÉ: Restreint l'accès en lecture au propriétaire uniquement
    match /driver_documents/{driverId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == driverId;
      allow write: if request.auth != null
                && request.auth.uid == driverId
                && request.resource.size < 10 * 1024 * 1024
                && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == driverId;
    }

    // Temporary CV intake: anonymous applicants may write only their own
    // application path. CVs remain private and are read by Admin SDK only.
    match /driverApplications/{applicantUid}/{applicationId}/cv/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == applicantUid
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.size <= 5 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document')
        && fileName.matches('^[a-zA-Z0-9._-]+\\.(pdf|docx)$');
      allow read, delete: if false;
    }
    
    // Images des véhicules
    match /vehicles/{vehicleId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
    
    // Documents de transaction/factures
    match /receipts/{userId}/{receiptId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024;
    }
    
    // Preuves de livraison (photos à la remise du colis)
    match /delivery_proofs/{orderId}/{filename} {
      allow write: if request.auth != null
        && request.auth.token.activeDeliveryOrderId == orderId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow read: if request.auth != null
        && (isDeliveryProofParticipant(orderId)
            || request.auth.token.get('admin', false) == true);
    }

    // Images des articles du menu (restaurant)
    match /menu-images/{restaurantId}/{itemId}/{uploadId} {
      // Lecture publique (les URLs issues de getDownloadURL sont utilisables par quiconque les possède)
      allow read: if true;

      // Création : Propriétaire du restaurant uniquement, WebP, max 500 Ko (500 * 1024 octets)
      allow create: if request.auth != null
        && firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId))
        && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid
        && request.resource.contentType == 'image/webp'
        && request.resource.size <= 500 * 1024;

      // Update : Refusé explicitement
      allow update: if false;

      // Suppression : Propriétaire du restaurant uniquement
      allow delete: if request.auth != null
        && firestore.exists(/databases/(default)/documents/restaurants/$(restaurantId))
        && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    // Bloquer tout le reste par défaut
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

